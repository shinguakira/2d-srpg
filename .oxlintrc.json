{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-console": "warn",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    // tsconfig の lib が ES2020 なので toSorted / toReversed は使えない。
    // 対象はいずれもローカルで作った配列なので破壊的でも問題ない。
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    // デバッグ用に window へ生やしている __game / __draw を許可する
    "no-underscore-dangle": ["error", { "allow": ["__game", "__draw"] }]
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true
  },
  // tools/ is command-line scripts, where console output is the interface and
  // sequential awaits are the point — the rules above are written for src/.
  "ignorePatterns": ["dist", "node_modules", "tools"]
}
