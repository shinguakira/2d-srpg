{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    // vitest runs with `globals: true`, so describe/it/expect are ambient.
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true,

    /* Bundler mode — matches tsconfig.app.json so tests see the same module
       resolution as the code they import. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting. `noUnusedLocals` is off here on purpose: test fixtures often
       build a unit and assert on the map rather than the variable, and
       oxlint already covers genuinely dead bindings in tests. */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["tests", "playwright.config.ts"]
}
